generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String?
  password String
  isActive Boolean @default(false)

  walltes       Wallets[]
  categories    Categories[]
  incomeSources IncomeSources[]
}

model Wallets {
  id   String  @id @default(cuid())
  name String
  icon String?

  currencyId      String
  userId          String
  incomeBalance   Int    @default(0)
  expensesBalance Int    @default(0)

  currnecy Currencies @relation(fields: [currencyId], references: [id])
  user     User       @relation(fields: [userId], references: [id])
  expenses Expenses[]
  incomes  Incomes[]
}

model Currencies {
  id     String @id @default(cuid())
  name   String
  format String

  wallets       Wallets[]
  budget        Budget[]
  incomeSources IncomeSources[]
}

model Categories {
  id     String  @id @default(cuid())
  title  String
  icon   String?
  userId String

  expenses Expenses[]
  budget   Budget[]
  user     User       @relation(fields: [userId], references: [id])
}

model Budget {
  currencyId String
  categoryId String
  amount     Int

  currency Currencies @relation(fields: [currencyId], references: [id])
  category Categories @relation(fields: [categoryId], references: [id])

  @@id([currencyId, categoryId])
}

model Expenses {
  id         String   @id @default(cuid())
  title      String
  icon       String?
  amount     Int      @default(0)
  date       DateTime
  categoryId String?
  walletId   String?

  category Categories? @relation(fields: [categoryId], references: [id])
  wallet   Wallets?    @relation(fields: [walletId], references: [id])
}

model IncomeSources {
  id         String  @id @default(cuid())
  title      String
  icon       String?
  userId     String
  currencyId String

  incomes  Incomes[]
  currency Currencies @relation(fields: [currencyId], references: [id])
  user     User       @relation(fields: [userId], references: [id])

  @@map("income_sources")
}

model Incomes {
  id       String   @id @default(cuid())
  title    String?
  icon     String?
  amount   Int      @default(0)
  date     DateTime
  sourceId String
  walletId String

  source IncomeSources @relation(fields: [sourceId], references: [id])
  wallet Wallets?      @relation(fields: [walletId], references: [id])
}
